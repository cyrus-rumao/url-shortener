
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./

ENV NODE_ENV=development
ENV NPM_CONFIG_PRODUCTION=false
ENV NPM_CONFIG_OMIT=""

RUN npm ci --include=dev

# Verify development dependencies during image build
RUN npm ls nodemon tsx --depth=0

COPY . .

RUN npx prisma generate

EXPOSE 2000

CMD ["npm", "run", "dev"]
